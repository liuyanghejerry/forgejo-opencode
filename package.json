{
  "name": "forgejo-opencode-oauth2",
  "version": "1.0.0",
  "description": "OpenCode OAuth2 plugin with Forgejo integration - replaces basic auth with secure OAuth2 authentication",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/server.ts --outdir=dist --target=bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "keywords": ["opencode", "forgejo", "oauth2", "plugin", "auth"],
  "license": "MIT"
}

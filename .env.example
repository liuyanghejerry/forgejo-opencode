# =============================================================================
# Forgejo OpenCode OAuth2 Stack — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ─── OAuth2 Proxy ───────────────────────────────────────────

# Port the OAuth2 proxy listens on (external access)
OAUTH2_PROXY_PORT=3000

# Your Forgejo instance URL
FORGEJO_URL=https://codeberg.org

# OAuth2 application credentials (create at: {FORGEJO_URL}/user/settings/applications)
FORGEJO_CLIENT_ID=your-client-id-here
FORGEJO_CLIENT_SECRET=your-client-secret-here

# JWT signing secret — REQUIRED, at least 32 characters
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# OAuth2 redirect URI (must match Forgejo app config)
# For local dev: http://localhost:3000/auth/callback
# For production: https://your-domain.com/auth/callback
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# Session cookie lifetime in seconds (default: 86400 = 24h)
SESSION_MAX_AGE=86400

# Optional: restrict access to specific Forgejo users (comma-separated)
# FORGEJO_ALLOWED_USERS=alice,bob

# Optional: set if behind an HTTPS reverse proxy
# BEHIND_PROXY=false
# COOKIE_DOMAIN=.example.com

# Optional: where encrypted Forgejo OAuth tokens are stored on disk
# (used by the bundled forgejo-mcp tool). Defaults to
# $HOME/.local/share/forgejo-oauth — the directory is created with mode 0700
# and individual token files with mode 0600.
# FORGEJO_TOKEN_STORE_DIR=/home/opencode/.local/share/forgejo-oauth

# ─── OpenCode Server ────────────────────────────────────────

OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1

# ─── LLM Provider API Keys (optional) ───────────────────────
# You can also mount auth.json instead of using env vars:
#   -v ~/.local/share/opencode/auth.json:/home/opencode/.local/share/opencode/auth.json:ro

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GITHUB_TOKEN=ghp_...

# ─── Docker Volumes ─────────────────────────────────────────

# Host directory to mount as workspace
WORKSPACE_DIR=./workspace

# Path to SSH private key for git operations inside container
# SSH_KEY_PATH=~/.ssh/id_ed25519
